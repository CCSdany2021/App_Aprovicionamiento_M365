# Microsoft 365 Provisioning - Configuración del Tenant

# --- Credenciales de Azure AD (App Registration) ---
TENANT_ID=tu_tenant_id_aqui
CLIENT_ID=tu_client_id_aqui
CLIENT_SECRET=tu_client_secret_aqui

# --- Configuración del Sistema ---
# El dominio que los estudiantes usarán (ej: colegio.edu.co)
COLEGIO_DOMINIO=dominio.edu.co
COLEGIO_NOMBRE=Nombre_Del_Colegio
COLEGIO_CODIGO=CODIGO

# --- Configuración por Defecto para Estudiantes ---
DEFAULT_CITY=Bogotá
DEFAULT_DEPARTMENT=Estudiantes
DEFAULT_JOB_TITLE=Estudiante
DEFAULT_USAGE_LOCATION=CO
DEFAULT_PASSWORD_POLICY=DisablePasswordExpiration

# --- Licencias (SKU IDs) ---
LICENSE_STUDENT=id_licencia_estudiante
LICENSE_FACULTY=id_licencia_profesor

# --- Email (Microsoft Graph API) ---
# Correo desde el cual se enviarán las credenciales
EMAIL_SENDER=admin@dominio.edu.co

# --- Credenciales de Acceso a esta Aplicación ---
ADMIN_USER=admin
ADMIN_PASSWORD=Cambiar_Esta_Clave

# --- Rutas de Archivos (Para ejecución local por comandos) ---
ARCHIVO_NUEVOS=archivos/estudiantesNuevos.xlsx
ARCHIVO_ACTUALIZAR=archivos/actualizacionEstudiantes.xlsx
CARPETA_RESULTADOS=resultados
CARPETA_LOGS=resultados/logs
